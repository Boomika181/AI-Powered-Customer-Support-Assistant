# ==============================================================================
# AI-Powered Customer Support Assistant - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your valid API keys below.
# 3. Never commit '.env' or any secret keys to version control.
# ==============================================================================

# AssemblyAI API Key for Speech-to-Text streaming
ASSEMBLYAI_API_KEY=

# Google Gemini API Key for Embeddings and LLM suggestions
GEMINI_API_KEY=

# Optional alternative name recognized by Google AI SDKs
GOOGLE_API_KEY=

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=technical_documentation

# Model Configurations
# NOTE: Architecture references gemini-embedding-2 and gemini-3.5-flash-lite.
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL=gemini-3.5-flash-lite

# Audio Capture Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# Speaker Diarization Role Mapping (AssemblyAI Streaming v3)
SPEAKER_A_ROLE=Customer
SPEAKER_B_ROLE=Agent

